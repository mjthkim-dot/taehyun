# ─────────────────────────────────────────────────────────────
# 미팅 어시스턴트 — Caddy 리버스 프록시 (권장 구성)
#
# Caddy를 앞에 세우는 이유 (docs/DEPLOY.md 참조):
#  · TLS 자동 발급·갱신 — 마이크(Web Speech)는 HTTPS에서만 동작한다
#  · 연결·헤더 타임아웃, HTTP/2 — 웹 노출면의 방어를 검증된 서버가 맡는다
#  · 앱 서버는 127.0.0.1에만 남는다
#
# 사용: 도메인을 바꾸고 → caddy run --config deploy/Caddyfile
# ─────────────────────────────────────────────────────────────

meeting.example.com {
	encode zstd gzip

	reverse_proxy 127.0.0.1:3799 {
		# 앱이 클라이언트 IP(로그인 락아웃)와 https 여부(쿠키 Secure)를 알게 한다.
		# 앱 쪽에는 TRUST_PROXY=1 이 함께 설정되어야 한다.
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto {scheme}

		# 토큰 스트리밍(NDJSON)이 버퍼에 모이면 실시간성이 죽는다
		flush_interval -1
	}

	# 요청 본문 상한 — 앱의 MAX_BODY(8MB)와 맞춘다
	request_body {
		max_size 8MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
