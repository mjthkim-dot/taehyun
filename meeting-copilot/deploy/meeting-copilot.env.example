# /etc/meeting-copilot.env 로 복사 후 chmod 600
GEMINI_API_KEY=...              # 기본 공급자 — aistudio.google.com/apikey (무료)
# GEMINI_TIER=paid              # 유료 결제 계정이면 선언 (무료 티어는 학습 사용 가능성 경고가 뜬다)
# GEMINI_MODEL=gemini-2.5-flash          # 제안·요약·자산화
# GEMINI_FAST_MODEL=gemini-2.5-flash-lite # 번역·한줄요약 (무료 RPM 최고)
# ANTHROPIC_API_KEY=sk-ant-...  # 폴백 (유료·학습 미사용 — 실미팅 권장)
# CEREBRAS_API_KEY=csk-...      # 폴백 (선택)
# NOTION_TOKEN=ntn_...          # Notion 수업 노트 동기화 (선택)
# LLM_RPM_PER_USER=15           # 사용자별 분당 LLM 호출 상한
# LLM_DAILY_PER_USER=600        # 사용자별 일일 상한
# STT_MAX_CONC=2                # 동시 음성 인식 상한 (로컬 Whisper 사용 시)
