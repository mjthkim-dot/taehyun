{
  "note": "리액션 뱅크 66개 — 회화 리액션 턴(2초 창)에서 학습자가 던질 짧은 한마디. fn: ack 12·surprise 10·sympathy 8·agree 8·followup 12·hedge 5·close 5·clarify 6. 기준: 고빈도 구어(Young & Lee 2004), 6단어 이하, A1/A2, 한국어 직역형(Yes yes / I know / Really really) 제외. when: 어떤 말 뒤에 쓰는지 한 줄.",
  "items": [
    { "id": "ack-01", "fn": "ack", "en": "Okay.", "kr": "알았어요.", "when": "상대가 설명하거나 뭔가 알려 준 뒤 — 듣고 있다는 신호", "level": "A1" },
    { "id": "ack-02", "fn": "ack", "en": "I see.", "kr": "그렇군요.", "when": "새 정보를 들었을 때 — 이해했다는 표시", "level": "A1" },
    { "id": "ack-03", "fn": "ack", "en": "Right.", "kr": "맞아요. / 그렇죠.", "when": "상대 말이 당연하거나 예상대로일 때", "level": "A1" },
    { "id": "ack-04", "fn": "ack", "en": "Got it.", "kr": "알겠어요.", "when": "지시·일정·방법을 들은 뒤", "level": "A1" },
    { "id": "ack-05", "fn": "ack", "en": "Sure.", "kr": "그럼요. / 네.", "when": "부탁이나 제안을 받았을 때 가볍게 받아주며", "level": "A1" },
    { "id": "ack-06", "fn": "ack", "en": "Oh, okay.", "kr": "아, 그래요.", "when": "예상과 조금 달랐지만 받아들일 때", "level": "A1" },
    { "id": "ack-07", "fn": "ack", "en": "Makes sense.", "kr": "말이 되네요.", "when": "이유나 설명을 듣고 납득했을 때", "level": "A2" },
    { "id": "ack-08", "fn": "ack", "en": "Gotcha.", "kr": "알겠어. (편한 사이)", "when": "친한 사람이 뭔가 설명한 뒤", "level": "A2" },
    { "id": "ack-09", "fn": "ack", "en": "All right.", "kr": "좋아요. / 알았어요.", "when": "다음으로 넘어가도 된다는 신호를 줄 때", "level": "A1" },
    { "id": "ack-10", "fn": "ack", "en": "Fair enough.", "kr": "그럴 만하네요.", "when": "완전 동의는 아니지만 이유를 인정할 때", "level": "A2" },
    { "id": "ack-11", "fn": "ack", "en": "Okay, cool.", "kr": "오케이, 좋아요.", "when": "약속·계획이 정해졌을 때 가볍게", "level": "A1" },
    { "id": "ack-12", "fn": "ack", "en": "Oh, I see.", "kr": "아, 그렇구나.", "when": "몰랐던 사정을 알게 됐을 때", "level": "A1" },

    { "id": "surprise-01", "fn": "surprise", "en": "Really?", "kr": "정말요?", "when": "뜻밖의 소식을 들었을 때 — 가장 많이 쓰는 한마디", "level": "A1" },
    { "id": "surprise-02", "fn": "surprise", "en": "Oh wow.", "kr": "와, 대박.", "when": "좋은 소식이나 큰 숫자를 들었을 때", "level": "A1" },
    { "id": "surprise-03", "fn": "surprise", "en": "No way!", "kr": "말도 안 돼!", "when": "믿기 힘든 이야기를 들었을 때", "level": "A1" },
    { "id": "surprise-04", "fn": "surprise", "en": "Seriously?", "kr": "진짜요?", "when": "놀랍거나 어이없는 소식 뒤", "level": "A2" },
    { "id": "surprise-05", "fn": "surprise", "en": "Oh, really?", "kr": "아, 정말요?", "when": "가볍게 놀라며 더 듣고 싶을 때", "level": "A1" },
    { "id": "surprise-06", "fn": "surprise", "en": "Are you serious?", "kr": "진심이에요?", "when": "큰 결정이나 사건을 들었을 때", "level": "A2" },
    { "id": "surprise-07", "fn": "surprise", "en": "You're kidding!", "kr": "농담이죠!", "when": "너무 좋거나 너무 황당한 소식 뒤", "level": "A2" },
    { "id": "surprise-08", "fn": "surprise", "en": "Oh my gosh.", "kr": "세상에.", "when": "깜짝 놀랄 일을 들었을 때", "level": "A1" },
    { "id": "surprise-09", "fn": "surprise", "en": "That's crazy.", "kr": "말도 안 되네요.", "when": "상상 못 한 전개를 들었을 때", "level": "A2" },
    { "id": "surprise-10", "fn": "surprise", "en": "Wait, what?", "kr": "잠깐, 뭐라고요?", "when": "갑작스러운 소식에 되물을 때", "level": "A2" },

    { "id": "sympathy-01", "fn": "sympathy", "en": "Oh no.", "kr": "저런.", "when": "작은 사고나 안 좋은 소식을 들었을 때", "level": "A1" },
    { "id": "sympathy-02", "fn": "sympathy", "en": "I'm sorry to hear that.", "kr": "안됐네요.", "when": "상대가 아프거나 힘든 일을 말했을 때", "level": "A1" },
    { "id": "sympathy-03", "fn": "sympathy", "en": "That's too bad.", "kr": "아쉽네요.", "when": "계획이 틀어지거나 취소됐다고 할 때", "level": "A1" },
    { "id": "sympathy-04", "fn": "sympathy", "en": "That sounds tough.", "kr": "힘들었겠어요.", "when": "바쁘거나 고생한 이야기를 들었을 때", "level": "A2" },
    { "id": "sympathy-05", "fn": "sympathy", "en": "That must be hard.", "kr": "많이 힘들겠어요.", "when": "지금도 겪고 있는 어려움을 말할 때", "level": "A2" },
    { "id": "sympathy-06", "fn": "sympathy", "en": "Hang in there.", "kr": "조금만 버텨요.", "when": "힘든 상황이 이어진다고 할 때 격려하며", "level": "A2" },
    { "id": "sympathy-07", "fn": "sympathy", "en": "Oh, I'm sorry.", "kr": "아, 안됐어요.", "when": "실망스러운 결과를 들었을 때", "level": "A1" },
    { "id": "sympathy-08", "fn": "sympathy", "en": "No worries.", "kr": "괜찮아요.", "when": "상대가 늦거나 실수해서 sorry라고 했을 때", "level": "A1" },

    { "id": "agree-01", "fn": "agree", "en": "Exactly.", "kr": "바로 그거예요.", "when": "내 생각과 똑같은 의견을 들었을 때", "level": "A1" },
    { "id": "agree-02", "fn": "agree", "en": "Totally.", "kr": "완전 동의.", "when": "친한 사이에서 강하게 동의할 때", "level": "A2" },
    { "id": "agree-03", "fn": "agree", "en": "I think so too.", "kr": "저도 그렇게 생각해요.", "when": "상대가 I think…로 의견을 말한 뒤", "level": "A1" },
    { "id": "agree-04", "fn": "agree", "en": "That's right.", "kr": "맞아요.", "when": "상대가 사실을 맞게 말했을 때", "level": "A1" },
    { "id": "agree-05", "fn": "agree", "en": "Good point.", "kr": "좋은 지적이에요.", "when": "내가 못 본 점을 짚어 줬을 때", "level": "A2" },
    { "id": "agree-06", "fn": "agree", "en": "I agree.", "kr": "동의해요.", "when": "의견이나 제안에 찬성할 때 — am 없이", "level": "A1" },
    { "id": "agree-07", "fn": "agree", "en": "Same here.", "kr": "저도요.", "when": "상대의 경험·상태가 나와 같을 때", "level": "A1" },
    { "id": "agree-08", "fn": "agree", "en": "Absolutely.", "kr": "물론이죠.", "when": "제안이나 의견에 강하게 찬성할 때", "level": "A2" },

    { "id": "followup-01", "fn": "followup", "en": "And then?", "kr": "그래서요?", "when": "이야기가 중간에 끊겼을 때 다음을 재촉하며", "level": "A1" },
    { "id": "followup-02", "fn": "followup", "en": "How come?", "kr": "왜요?", "when": "이유가 궁금한 결과를 들었을 때", "level": "A2" },
    { "id": "followup-03", "fn": "followup", "en": "Why's that?", "kr": "왜 그런데요?", "when": "의견이나 결정의 이유를 물을 때", "level": "A2" },
    { "id": "followup-04", "fn": "followup", "en": "How was it?", "kr": "어땠어요?", "when": "어디 갔다 왔거나 뭔가 해 봤다고 할 때", "level": "A1" },
    { "id": "followup-05", "fn": "followup", "en": "What happened?", "kr": "무슨 일이에요?", "when": "안 좋은 일이 있었다는 낌새가 보일 때", "level": "A1" },
    { "id": "followup-06", "fn": "followup", "en": "Like what?", "kr": "예를 들면요?", "when": "두루뭉술한 말(stuff, things)을 들었을 때", "level": "A2" },
    { "id": "followup-07", "fn": "followup", "en": "What do you mean?", "kr": "무슨 뜻이에요?", "when": "말의 의도가 애매할 때", "level": "A1" },
    { "id": "followup-08", "fn": "followup", "en": "Tell me more.", "kr": "더 얘기해 줘요.", "when": "흥미로운 이야기가 시작됐을 때", "level": "A1" },
    { "id": "followup-09", "fn": "followup", "en": "So what did you do?", "kr": "그래서 어떻게 했어요?", "when": "문제 상황을 들은 뒤 대처가 궁금할 때", "level": "A1" },
    { "id": "followup-10", "fn": "followup", "en": "How did it go?", "kr": "잘 됐어요?", "when": "미팅·발표·시험이 있었다고 할 때", "level": "A1" },
    { "id": "followup-11", "fn": "followup", "en": "What about you?", "kr": "당신은요?", "when": "내 근황을 말하고 상대 차례로 넘길 때", "level": "A1" },
    { "id": "followup-12", "fn": "followup", "en": "Since when?", "kr": "언제부터요?", "when": "새 습관·새 일을 시작했다고 할 때", "level": "A2" },

    { "id": "hedge-01", "fn": "hedge", "en": "Well...", "kr": "음, 글쎄요…", "when": "질문을 받고 답을 고르는 중일 때", "level": "A1" },
    { "id": "hedge-02", "fn": "hedge", "en": "Let me think.", "kr": "잠깐 생각해 볼게요.", "when": "바로 답하기 어려운 질문 뒤", "level": "A1" },
    { "id": "hedge-03", "fn": "hedge", "en": "I'm not sure.", "kr": "잘 모르겠어요.", "when": "확실하지 않은 사실을 물었을 때", "level": "A1" },
    { "id": "hedge-04", "fn": "hedge", "en": "Kind of.", "kr": "좀 그렇죠.", "when": "예/아니오로 딱 답하기 애매할 때", "level": "A2" },
    { "id": "hedge-05", "fn": "hedge", "en": "It depends.", "kr": "상황에 따라 달라요.", "when": "조건에 따라 답이 달라지는 질문 뒤", "level": "A2" },

    { "id": "close-01", "fn": "close", "en": "Sounds good.", "kr": "좋아요.", "when": "약속이나 계획을 정하고 마무리할 때", "level": "A1" },
    { "id": "close-02", "fn": "close", "en": "Talk to you later.", "kr": "나중에 또 얘기해요.", "when": "대화를 끝내고 헤어질 때", "level": "A1" },
    { "id": "close-03", "fn": "close", "en": "Have a good one.", "kr": "좋은 하루 보내요.", "when": "낮에 헤어지며 가볍게 인사할 때", "level": "A2" },
    { "id": "close-04", "fn": "close", "en": "See you then.", "kr": "그때 봐요.", "when": "다음 약속 시간을 정한 뒤", "level": "A1" },
    { "id": "close-05", "fn": "close", "en": "Take care.", "kr": "잘 지내요.", "when": "당분간 못 볼 사람과 헤어질 때", "level": "A1" },

    { "id": "clarify-01", "fn": "clarify", "en": "Sorry?", "kr": "네? (못 들었어요)", "when": "한 마디를 놓쳤을 때 — 가장 짧은 되묻기", "level": "A1" },
    { "id": "clarify-02", "fn": "clarify", "en": "Could you say that again?", "kr": "다시 말씀해 주시겠어요?", "when": "문장 전체를 못 알아들었을 때", "level": "A1" },
    { "id": "clarify-03", "fn": "clarify", "en": "You mean...?", "kr": "그러니까 …라는 말이죠?", "when": "들은 내용을 내 말로 확인할 때", "level": "A2" },
    { "id": "clarify-04", "fn": "clarify", "en": "Could you slow down a bit?", "kr": "조금만 천천히 말해 주시겠어요?", "when": "상대가 너무 빨라서 따라가기 힘들 때", "level": "A1" },
    { "id": "clarify-05", "fn": "clarify", "en": "What's that?", "kr": "그게 뭐예요?", "when": "모르는 단어나 이름이 나왔을 때", "level": "A1" },
    { "id": "clarify-06", "fn": "clarify", "en": "One more time, please?", "kr": "한 번만 더요.", "when": "숫자·날짜·이름을 다시 듣고 싶을 때", "level": "A1" }
  ]
}
