{
  "functions": {
    "api/transcript.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/app", "destination": "https://taehyun-app.vercel.app/app" },
    { "source": "/app/:path*", "destination": "https://taehyun-app.vercel.app/app/:path*" },
    { "source": "/((?!voice-assistant/|api/|app|app/|sw\\.js|manifest\\.webmanifest).*)", "destination": "/voice-assistant/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    }
  ]
}
